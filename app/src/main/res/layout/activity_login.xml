<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical" android:padding="28dp" android:gravity="center" android:layout_width="match_parent" android:layout_height="match_parent" android:background="#F3F7F5">
    <TextView android:text="EcoControl IoT" android:textSize="30sp" android:textStyle="bold" android:textColor="#14532D" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <TextView android:text="Monitoreo seguro de un invernadero" android:textSize="16sp" android:layout_marginTop="8dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
    <EditText android:id="@+id/user" android:hint="Usuario" android:inputType="text" android:layout_marginTop="32dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <EditText android:id="@+id/password" android:hint="Contraseña" android:inputType="textPassword" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <Button android:id="@+id/loginButton" android:text="INGRESAR" android:layout_marginTop="20dp" android:layout_width="match_parent" android:layout_height="wrap_content" />
    <TextView android:id="@+id/loginMessage" android:text="Demo: admin / IoT2026" android:textColor="#4B5563" android:layout_marginTop="14dp" android:layout_width="wrap_content" android:layout_height="wrap_content" />
</LinearLayout>
